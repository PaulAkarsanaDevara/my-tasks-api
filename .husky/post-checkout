# $3 = 1 jika checkout branch, 0 jika checkout file
if [ "$3" != "1" ]; then
  exit 0
fi

# Cek apakah TTY tersedia
if [ ! -t 0 ]; then
  echo "ℹ️ Non-interactive checkout detected. Skipping dependency prompt."
  exit 0
fi

echo ""
echo "🔀 Branch checkout detected."

printf "🧹 Clean node_modules & install dependencies? (y/N): "
read answer < /dev/tty

case "$answer" in
  y|Y)

    echo ""
    echo "🗑 Removing node_modules..."
    rm -rf node_modules

    # if [ -d "node_modules" ]; then
    #   echo ""
    #   echo "🗑 Removing node_modules..."
    #   rm -rf node_modules
    # fi

    # if [ -d "package-lock.json" ]; then
    #   echo ""
    #   echo "🗑 Removing package-lock.json..."
    #   rm -rf kage-lock.json
    # fi

    echo "🧹 Cleaning npm cache..."
    npm cache clean --force

    echo ""
    echo "📦 Installing dependencies..."
    npm install

    echo ""
    echo "✅ Dependencies installed successfully."
    ;;
  *)
    echo ""
    echo "⏭ Skipped dependency installation."
    ;;
esac